version: 1.5.7
port: 7054

tls:
  enabled: true
  certfile: /var/lib/hephaestus/tls-cert.pem
  keyfile:  /var/lib/hephaestus/tls-key.pem

ca:
  name: ca-{{ org }}
  keyfile:  /var/lib/hephaestus/ca-key.pem
  certfile: /var/lib/hephaestus/ca-cert.pem

registry:
  maxenrollments: -1
  identities:
    - name: admin
      pass: hephaestus_admin_dev_only   # rotate this on first run!
      type: client
      affiliation: ""
      attrs:
        hf.Registrar.Roles: "*"
        hf.Registrar.DelegateRoles: "*"
        hf.Revoker: true
        hf.IntermediateCA: true
        hf.GenCRL: true
        hf.AffiliationMgr: true

affiliations:
  {{ org | lower }}:
    - operations
    - audit

csr:
  cn: ca.{{ org | lower }}.hephaestus.id
  names:
    - C: ID
      ST: DKI Jakarta
      L: Jakarta
      O: {{ org }}
      OU: Hephaestus

operations:
  listenAddress: 0.0.0.0:9444

intermediate:
  parentserver:
    url: ""
