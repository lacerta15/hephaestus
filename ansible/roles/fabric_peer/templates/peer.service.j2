[Unit]
Description=Hephaestus Hyperledger Fabric Peer ({{ inventory_hostname }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hephaestus
Group=hephaestus
Environment=FABRIC_CFG_PATH=/etc/hephaestus
Environment=CORE_PEER_ID={{ inventory_hostname }}
Environment=CORE_PEER_ADDRESS={{ inventory_hostname }}:7051
Environment=CORE_PEER_LOCALMSPID={{ msp_id }}
Environment=CORE_PEER_MSPCONFIGPATH=/var/lib/hephaestus/msp
Environment=CORE_PEER_TLS_ENABLED=true
Environment=CORE_PEER_TLS_CERT_FILE=/var/lib/hephaestus/tls/server.crt
Environment=CORE_PEER_TLS_KEY_FILE=/var/lib/hephaestus/tls/server.key
Environment=CORE_PEER_TLS_ROOTCERT_FILE=/var/lib/hephaestus/tls/ca.crt
Environment=CORE_LEDGER_STATE_STATEDATABASE=CouchDB
Environment=FABRIC_LOGGING_SPEC=INFO

ExecStart=/usr/local/bin/peer node start
Restart=on-failure
RestartSec=10s
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hephaestus /var/log/hephaestus

[Install]
WantedBy=multi-user.target
